{
  "name": "walrus-client",
  "version": "0.1.0",
  "private": true,
  "dependencies": {
    "@mysten/sui": "^1.40.0",
    "@mysten/sui.js": "^0.54.1",
    "@mysten/wallet-standard": "^0.19.0",
    "@tanstack/react-query": "^5.90.2",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^13.5.0",
    "@walletconnect/modal": "^2.7.0",
    "@walletconnect/web3-provider": "^1.8.0",
    "axios": "^1.12.2",
    "bootstrap": "^5.3.8",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-router-dom": "^7.9.4",
    "react-scripts": "5.0.1",
    "web-vitals": "^2.1.4"
  },
  "devDependencies": {
    "concurrently": "^8.2.2"
  },
  "scripts": {
    "start": "react-scripts start",
    "build": "react-scripts build",
    "test": "react-scripts test",
    "eject": "react-scripts eject",
    "dev": "concurrently --kill-others-on-fail --prefix-colors \"cyan,magenta\" --names \"BACKEND,FRONTEND\" \"npm run server\" \"npm run client\"",
    "dev:windows": "start-dev.bat",
    "dev:ps1": "powershell -ExecutionPolicy Bypass -File start-dev.ps1",
    "server": "cd server && npm run dev",
    "client": "react-scripts start",
    "install-all": "npm install && cd server && npm install",
    "setup": "node setup-dev.js",
    "dev:clean": "npm run install-all && npm run dev",
    "stop": "taskkill /f /im node.exe 2>nul || echo 'No Node processes to kill'"
  },
  "eslintConfig": {
    "extends": [
      "react-app",
      "react-app/jest"
    ]
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "description": "A decentralized data marketplace built on Walrus storage, where data providers can upload and monetize datasets while data buyers can discover, purchase, and download valuable data.",
  "main": "index.js",
  "keywords": [],
  "author": "",
  "license": "ISC"
}
