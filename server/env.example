# Server Configuration
PORT=5000
NODE_ENV=development

# Database
MONGODB_URI=mongodb://localhost:27017/walrus-marketplace

# JWT Secret
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production

# Walrus Configuration
WALRUS_RPC_URL=https://rpc.walrus.network
WALRUS_API_KEY=your-walrus-api-key

# Sui Configuration
SUI_RPC_URL=https://fullnode.mainnet.sui.io:443
SUI_NETWORK=mainnet

# Platform Configuration
PLATFORM_FEE=0.05
PLATFORM_WALLET_ADDRESS=your-platform-wallet-address

# File Upload Limits
MAX_FILE_SIZE=104857600
ALLOWED_FILE_TYPES=text/csv,application/json,application/xml,text/plain,application/vnd.ms-excel,application/vnd.openxmlformats-officedocument.spreadsheetml.sheet,application/pdf,application/zip,application/x-zip-compressed

# CORS Configuration
CORS_ORIGIN=http://localhost:3000

# Email Configuration (optional)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password

# Redis Configuration (optional, for caching)
REDIS_URL=redis://localhost:6379
